{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LakeQuest Prediction",
  "type": "object",
  "required": ["qa_id", "answer"],
  "properties": {
    "qa_id": { "type": "string", "minLength": 1 },
    "answer": { "type": "string" },
    "object_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provenance_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": true
}
